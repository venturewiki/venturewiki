{
  "name": "venturewiki-mcp",
  "version": "0.1.0",
  "private": true,
  "description": "Model Context Protocol server for VentureWiki — let agents CRUD public and private ventures on a user's GitHub account or the venturewiki organization.",
  "type": "module",
  "bin": {
    "venturewiki-mcp": "dist/index.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "js-yaml": "^4.1.0",
    "octokit": "^4.1.4",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^20.14.0",
    "tsx": "^4.21.0",
    "typescript": "^5.5.0"
  }
}
